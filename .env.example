# Copy to .env and adjust. Never commit the real .env — on the AWS path secrets
# live in Secrets Manager/SSM (pattern documented in docs/, not hardcoded here).

# --- Local stack endpoints (docker-compose defaults) ---
LOCALSTACK_ENDPOINT=http://localhost:4566
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
TRINO_URL=http://localhost:8089

# --- Environment switch ---
# local -> LocalStack + MinIO + schema-file shim for schema registry
# aws   -> real AWS endpoints + Glue Schema Registry
ENV=local

# --- AWS path (used when ENV=aws) ---
AWS_REGION=us-east-1
AWS_PROFILE=default
KINESIS_STREAM_NAME=retail-orders
LAKE_BUCKET=aws-streaming-batch-platform-lake
SCHEMA_REGISTRY_NAME=retail-schemas
